# Скопируй в .env и заполни значения:
#   cp .env.example .env

# ── Обязательно сменить! ───────────────────────────────────────────────────────
JWT_SECRET=замени_на_длинную_случайную_строку_минимум_32_символа

# ── Твой IP или домен ─────────────────────────────────────────────────────────
# Если несколько — через запятую: http://158.160.84.189,https://mysite.com
CORS_ORIGIN=http://158.160.84.189

# ── Порт сервера (обычно не трогать) ──────────────────────────────────────────
PORT=3001

# ── Адрес привязки (необязательно) ────────────────────────────────────────────
# 127.0.0.1 — слушать только локально, когда снаружи стоит nginx/reverse-proxy.
# Пусто — слушать на всех интерфейсах (как раньше).
# HOST=127.0.0.1
